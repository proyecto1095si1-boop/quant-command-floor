{
  "name": "quant-command-floor",
  "version": "0.2.0",
  "private": true,
  "description": "Pixel multi-agent crypto hedge fund command floor",
  "scripts": {
    "format": "prettier --write server dist tests",
    "format:check": "prettier --check server dist tests",
    "lint": "eslint server dist tests",
    "coverage": "c8 --all --include='server/**/*.js' --reporter=text --reporter=json-summary --check-coverage --lines=84 npm test",
    "start": "node --use-env-proxy server/index.js",
    "serve:ui": "python3 -m http.server 8080 --directory dist",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10"
  }
}
